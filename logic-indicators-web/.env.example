# =============================================================================
# Variables de entorno — Logic Indicators Web
# =============================================================================
# 1. Copiar este archivo a `.env` y completar los valores reales:
#      cp .env.example .env
# 2. El `.env` esta en .gitignore, asi que NO se commitea.
# 3. Vite expone las variables al cliente SOLO si arrancan con VITE_.
#    Todo lo que no arranque con VITE_ queda en el server (no aplica,
#    esta es una SPA pura, pero es la convencion para futuro SSR).
# 4. Para produccion, las variables se configuran en Cloudflare Pages
#    (Project Settings > Environment variables).
# =============================================================================

# -----------------------------------------------------------------------------
# EmailJS (envio de formulario de contacto)
# Obtener estas keys en https://dashboard.emailjs.com/
# -----------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# -----------------------------------------------------------------------------
# Google reCAPTCHA v2 (anti-spam del formulario de contacto)
# Obtener en https://www.google.com/recaptcha/admin
# -----------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
