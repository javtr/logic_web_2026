{
  "pageTitle": "Indicator Presets",
  "pageSubtitle": "Pre-configured XML files to load our indicators with optimal visual and technical settings. Drop them into NinjaTrader 8 and start trading in seconds.",
  "cta": "Download",
  "emptyMessage": "No presets available yet.",

  "tutorial": {
    "title": "How to import a preset",
    "subtitle": "Two steps and you're done. The XML file configures every visual and technical setting so you don't have to tune anything by hand.",
    "stepLabel": "Step",
    "steps": [
      {
        "stepNumber": 1,
        "title": "Download the XML file",
        "description": "Click the download button on the preset card you want to use. The XML will save to your computer.",
        "imageKey": "tutorial_step_1"
      },
      {
        "stepNumber": 2,
        "title": "Import them in NinjaTrader 8",
        "description": "Inside NinjaTrader 8:",
        "steps": [
          "Go to the Configurations button.",
          "Click on 'Import Logic Presets'.",
          "Click on 'Import Local File'."
        ],
        "note": "You can select and import several XML files at once — no need to repeat the process one by one.",
        "imageKey": "tutorial_step_2"
      }
    ]
  },

